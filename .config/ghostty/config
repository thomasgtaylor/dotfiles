theme = Atom One Light
font-family = "FiraCode Nerd Font Mono"
font-size = "18"
font-thicken = true

shell-integration-features = no-cursor
cursor-style = "block"
cursor-style-blink = false

macos-titlebar-style = "tabs"
macos-titlebar-proxy-icon = "hidden"
keybind = shift+enter=text:\x1b\r
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
keybind = super+]=csi:93;9u
keybind = super+[=csi:91;9u
keybind = alt+bracket_right=csi:93;3u
keybind = alt+bracket_left=csi:91;3u
keybind = super+p=csi:112;9u
keybind = super+r=csi:114;9u
keybind = super+t=csi:116;9u

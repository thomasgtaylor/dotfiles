# Follow the terminal palette using ANSI color names, with no separate RGB palette.
set -g fish_color_normal normal
set -g fish_color_command normal
set -g fish_color_keyword brmagenta
set -g fish_color_quote brgreen
set -g fish_color_redirection brmagenta
set -g fish_color_end brmagenta
set -g fish_color_error brred
set -g fish_color_param brblue
set -g fish_color_operator normal
set -g fish_color_comment brblack
set -g fish_color_autosuggestion brblack
set -g fish_color_escape brcyan
set -g fish_color_search_match --background=brwhite
set -g fish_color_selection --background=brwhite
set -g fish_color_cancel --reverse
set -g fish_color_valid_path --underline
set -g fish_pager_color_prefix brblue --bold
set -g fish_pager_color_completion normal
set -g fish_pager_color_description brblack
set -g fish_pager_color_progress brcyan
set -g fish_pager_color_background normal
set -g fish_pager_color_selected_background --background=brwhite
set -g fish_pager_color_selected_prefix brblue --bold
set -g fish_pager_color_selected_completion normal
set -g fish_pager_color_selected_description normal
set -g fish_pager_color_secondary_background normal
set -g fish_pager_color_secondary_prefix brblue
set -g fish_pager_color_secondary_completion normal
set -g fish_pager_color_secondary_description brblack
set -g hydro_color_pwd brgreen
set -g hydro_color_git brmagenta
set -g hydro_color_prompt normal
set -g hydro_color_error brred
set -g hydro_color_duration brblack
